{% extends 'base.html.twig' %}

{% block title %}User {{ user.email }} : administration{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item">
        <a href="{{ path('app_admin_user_index') }}">Users administration</a>
    </li>
    <li class="breadcrumb-item">{{ user.email }}</li>
{% endblock %}

{% block body %}
    <h1><span class="title-text-light">User</span> {{ user.email }}</h1>

    <div class="container">
        <div class="row gy-2">
            <div class="card">
                <div class="card-header">
                    Informations
                </div>
                <div class="card-body">
                    Email : {{ user.email }}<br/>
                    Role : {{ 'ROLE_ADMIN' in user.roles ? 'admin' : 'user' }}<br/>
                    Status :
                    {% if user.enabled %}
                        <span class="badge bg-success">active</span>
                    {% else %}
                        <span class="badge bg-danger">disabled</span>
                    {% endif %}
                    <br/>
                    Email verified : {{ user.verified ? 'yes' : 'no' }}<br/>
                    Created at : {{ user.createdAt|date('Y-m-d H:i:s') }}<br/>
                    Last login : {{ user.lastLoginAt ? user.lastLoginAt|date('Y-m-d H:i:s') : 'never' }}<br/>
                    Projects : {{ projectCount }}
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        {% if user.enabled %}
            <form style="display:inline" method="post" action="{{ path('app_admin_user_disable', {id: user.id}) }}" onsubmit="return confirm('Are you sure you want to disable this user? They will no longer be able to log in.');">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_user_disable' ~ user.id) }}">
                <button class="btn btn-warning">Disable</button>
            </form>
        {% else %}
            <form style="display:inline" method="post" action="{{ path('app_admin_user_enable', {id: user.id}) }}" onsubmit="return confirm('Are you sure you want to enable this user? They will be able to log in again.');">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_user_enable' ~ user.id) }}">
                <button class="btn btn-success">Enable</button>
            </form>
        {% endif %}
        {% if 'ROLE_ADMIN' in user.roles %}
            <form style="display:inline" method="post" action="{{ path('app_admin_user_demote', {id: user.id}) }}" onsubmit="return confirm('Are you sure you want to demote this administrator to regular user? They will be logged out and lose access to the administration.');">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_user_demote' ~ user.id) }}">
                <button class="btn btn-outline-primary">Demote to user</button>
            </form>
        {% else %}
            <form style="display:inline" method="post" action="{{ path('app_admin_user_promote', {id: user.id}) }}" onsubmit="return confirm('Are you sure you want to promote this user to administrator? They will be logged out and must log in again.');">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_user_promote' ~ user.id) }}">
                <button class="btn btn-outline-primary">Promote to admin</button>
            </form>
        {% endif %}
        <form style="display:inline" method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}" onsubmit="return confirm('Are you sure you want to delete this user? Their {{ projectCount }} project(s), medias and files will be permanently deleted.');">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_user_delete' ~ user.id) }}">
            <button class="btn btn-danger">Delete</button>
        </form>
        <a href="{{ path('app_admin_user_index') }}" class="btn btn-outline-secondary">Back to list</a>
    </div>
{% endblock %}
